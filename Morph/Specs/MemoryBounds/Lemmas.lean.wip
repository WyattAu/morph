import Morph.Specs.MemoryBounds.Spec

namespace Morph.Specs.MemoryBounds

/-!
## Reachability basics
-/

theorem Reach.mono_base (h : Heap) (base base' : List Addr) (a : Addr)
    (hsub : ∀ x, x ∈ base → x ∈ base') (hr : Reach h base a) :
    Reach h base' a := by
  induction hr with
  | base_ x hx => exact .base_ x (hsub x hx)
  | edge_ x f fs hlook hfin hrec ih => exact .edge_ x f fs hlook hfin ih

/-!
## Step-local preservation of `Precise`
-/

/-- Allocating a *fresh* address (old entry `none`) cannot break any
reachability: the fresh address has no edges in the old heap, so no path
passes through it, and the new root only enlarges the base. -/
theorem reach_alloc (h : Heap) (a : Addr) (v : Option (List Addr))
    (base : List Addr) (hfresh : h a = none)
    (x : Addr) (hr : Reach h base x) :
    Reach (hUpd h a v) (a :: base) x := by
  induction hr with
  | base_ y hy => exact .base_ y (List.mem_cons_of_mem _ hy)
  | @edge_ y g fs hlook hfin hrec ih =>
      refine .edge_ y g _ ?_ hfin ih
      have hya : y ≠ a := by
        intro he; subst he
        rw [hfresh] at hlook
        simp at hlook
      rw [hUpd_ne h a v y hya]
      exact hlook

/-- Collection deletes one entry and re-roots its children in the pending
queue: reachability of every other live address survives. -/
theorem reach_del (h h' : Heap) (base base' : List Addr) (a : Addr)
    (hnone : h' a = none)
    (hothers : ∀ y, y ≠ a → h' y = h y)
    (hbase : ∀ z, z ∈ base → z ≠ a → z ∈ base')
    (hchildren : ∀ g, g ∈ ((h a).getD []) → g ∈ base')
    (x : Addr) (hx : Reach h base x) (hxa : x ≠ a) :
    Reach h' base' x := by
  induction hx with
  | base_ y hy => exact .base_ y (hbase y hy hxa)
  | @edge_ y g fs hlook hfin hrec ih =>
      by_cases hya : y = a
      · subst hya
        refine .base_ g ?_
        rw [hlook] at hchildren
        exact hchildren g hfin
      · refine .edge_ y g _ ?_ hfin (ih hya)
        rw [hothers y hya]
        exact hlook

theorem precise_preserved (c c' : Config) (hstep : Step c c') :
    Precise c → Precise c' := by
  cases hstep with
  | alloc a hfresh =>
      intro hp
      obtain ⟨hp1, hp2⟩ := hp
      have hna : a ∉ c.roots := fun hmem => (hp2 a hmem) hfresh
      refine ⟨?_, ?_⟩
      · intro x hx
        dsimp only
        simp only [hUpd] at hx
        by_cases hxa : x = a
        · rw [if_pos hxa] at hx
          exact .base_ x (by simp [hxa, hfresh])
        · rw [if_neg hxa] at hx
          exact reach_alloc c.heap a (some []) (c.roots ++ c.pending) hfresh x
            (hp1 x hx)
      · intro z hz
        dsimp only
        simp only [List.mem_append, List.mem_cons] at hz
        rcases hz with hz | hz
        · rw [hz, hUpd_self]
          simp
        · rw [hUpd_ne c.heap a (some []) z (fun he => hna (by rw [← he]; exact hz))]
          exact hp2 z hz
  | dropRoot a har =>
      intro hp
      obtain ⟨hp1, hp2⟩ := hp
      refine ⟨?_, ?_⟩
      · intro x hx
        have hmono : Reach c.heap ((c.roots.erase a) ++ (c.pending ++ [a])) x := by
          refine Reach.mono_base _ _ _ _ ?_ (hp1 x hx)
          intro z hz
          simp only [List.mem_append] at hz ⊢
          rcases hz with hz | hz
          · exact Or.inl (List.mem_of_mem_erase hz)
          · simp only [List.mem_append] at hz
            rcases hz with hz | hz
            · exact Or.inr (Or.inl hz)
            · exact Or.inr (Or.inr hz)
        simpa using hmono
      · intro z hz
        by_cases hza : z = a
        · subst hza
          exact hp2 a hara
        · exact hp2 z ((List.mem_erase_of_ne hza).mp hz)
  | collect a fs hap hlook =>
      intro hp
      obtain ⟨hp1, hp2⟩ := hp
      refine ⟨?_, ?_⟩
      · intro x hx
        dsimp only at hx
        have hxa : x ≠ a := by
          intro he
          subst he
          rw [hDel, hUpd, if_pos rfl] at hx
          exact hx rfl
        have hreach := hp1 x hx
        refine reach_del c.heap (hDel c.heap a) (c.roots ++ c.pending)
          (c.roots ++ ((c.pending.erase a) ++ fs)) a (by simp [hDel]) (by
          intro y hy
          simp only [hDel, hUpd, ne_eq, hy, if_false]) ?_ ?_ x hreach hxa
        · intro z hz hza
          simp only [List.mem_append] at hz ⊢
          rcases hz with hz | hz
          · exact Or.inl hz
          · simp only [List.mem_append] at hz
            rcases hz with hz | hz
            · exact Or.inr (Or.inl ((List.mem_erase_of_ne hza).mp hz))
            · exact Or.inr (Or.inr (List.mem_cons_of_mem _ hz))
        · intro g hg
          rw [hlook] at hg
          simp only [List.mem_append] at hg
          exact Or.inr (Or.inr hg)
      · intro z hz
        dsimp only
        exact hp2 z hz

/-!
## SG-002 headline theorems
-/

/-- **No leaks at quiescence.** When the pending queue is empty, every live
heap address is reachable from the roots alone. -/
theorem quiescent_no_leak (c : Config) (hp : Precise c)
    (hempty : c.pending = []) :
    ∀ a, c.heap a ≠ none → Reach c.heap c.roots a := by
  intro a ha
  have h := hp.1 a ha
  simpa [hempty] using h

/-- Growth is paid for by allocation: `alloc` bumps the counter by one;
every other step keeps it. -/
theorem allocs_step (c c' : Config) (hstep : Step c c') :
    c'.allocs ≤ c.allocs + 1 := by
  cases hstep with
  | alloc _ _ => omega
  | dropRoot _ _ _ => omega
  | collect _ _ _ _ _ => omega

/-- **Heap bound (SG-002).** After any n-step execution the allocation
counter has advanced by at most n; only `alloc` advances it. -/
theorem allocs_bound (n : Nat) (c₀ cₙ : Config) (hrun : Steps n c₀ cₙ) :
    cₙ.allocs ≤ c₀.allocs + n := by
  induction hrun with
  | refl => omega
  | tail _ hstep ih =>
      have h1 := allocs_step _ _ hstep
      omega

end Morph.Specs.MemoryBounds
