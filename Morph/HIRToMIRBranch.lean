                              simp only [] at hrem
                              have hrem_c : (res, env') = runHIRWhile fh env2 c body := hrem.symm
                              obtain ⟨ihV, ihR⟩ := ih envB
                                ⟨fenvC.env.update s1 Value.unit, fenvC.store⟩ HFlow.continued env2
