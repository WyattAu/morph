      ∀ (blk : Block), findBlock f info.exit = some blk →
      ∃ F' fenv_arr blkPrev, F' ≤ F ∧ F' ≥ C ∧
        execBlockFromIn prog F f prev ⟨bId, L.instrs, L.term⟩ fenv =
