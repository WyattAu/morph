                                  heq_body.trans (hbranch1.trans (hexit1.trans heqI)), hrelI, hunitI⟩
                              · intro e hres
                                obtain ⟨w_e, hew, heqI⟩ := ihR e hres
                                exact ⟨w_e, hew,
                                  heq_body.trans (hbranch1.trans (hexit1.trans heqI))⟩
