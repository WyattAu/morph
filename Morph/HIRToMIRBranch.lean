                            lb.blocks ++ [⟨nextB + 2, .const s1 .unit :: lb.instrs, lb.term⟩] ++
                            [⟨nextB, phis ++ ic, .branch vc (nextB + 2) (nextB + 1)⟩] ++
                            [⟨nextB + 1, .const lb.supply .unit :: lr.instrs, lr.term⟩] ++ lr.blocks := by
