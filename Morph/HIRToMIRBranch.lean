          simp only [] at h
          cases fuel with
          | zero =>
              rw [runHIRStmts_zero] at hrun
              cases hrun
              rfl
          | succ fh =>
              simp only [runHIRStmts] at hrun
              cases hev : evalHIR 256 henv e with
              | none =>
                  rw [hev] at hrun
                  simp only [] at hrun
                  cases hrun
                  rfl
