                            | _ =>
                                simp only [htb] at hfb
                                exact absurd hfb (by simp)
                          obtain ⟨b, hb, rfl⟩ := hmemF
                          have hb2 := hbnd b hb
                          have hle : nextB ≤ b.id := Nat.le_trans (Nat.le_add_right _ _) hb2.1
                          exact Nat.ne_of_gt (Nat.lt_of_lt_of_le hltB hle)
