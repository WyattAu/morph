      · intro hres
        simp only [runHIRWhile] at hrun
        cases heval : evalHIR 256 henv c with
        | none =>
            rw [heval] at hrun
            have hst : res = .stuck := (congrArg Prod.fst hrun).symm
            rw [hst] at hres
            exact absurd hres (by simp)
        | some r =>
            rw [heval] at hrun
