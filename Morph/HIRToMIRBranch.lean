                            ∃ w, lookupHEnv envA id = some (.lit w) := by
                          intro idr rr hmem
                          obtain ⟨w0, h0⟩ := hP idr rr hmem
                          have hlook : lookupHEnv envA idr = lookupHEnv henv idr :=
                            runHIRStmts_arm_lookup budget hath fh henv envA _ _ idr har
