#!/usr/bin/env bash
# Pre-commit hook for Morph monorepo
# Enforces: Lean 4 compilation, build-quality gates (warnings, sorrys, stubs,
#           cross-references, spec links), Python spec-tools tests, ruff lint,
#           ruff format, mypy type-check, and spec-tools lint.
#
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# The gates themselves live in scripts/check-gates.sh so this hook and CI run
# the same rules; this file only sequences them with the build it already does.

set -euo pipefail

echo "========================================="
echo " Morph Pre-Commit Check"
echo "========================================="
echo ""

# Step 1: Lake build (compile all Lean 4 sources)
echo "[1/6] Running lake build Morph..."
BUILD_START=$(date +%s)
BUILD_LOG=$(mktemp /tmp/morph_precommit_build_XXXXXX.log)

if lake build Morph 2>&1 | tee "$BUILD_LOG"; then
    BUILD_END=$(date +%s)
    BUILD_SECS=$((BUILD_END - BUILD_START))
    echo ""
    echo "[1/6] Lake build PASSED (${BUILD_SECS}s)"
else
    echo ""
    echo "[1/6] Lake build FAILED"
    echo ""
    echo "First 10 errors:"
    grep "^error:" "$BUILD_LOG" | head -10
    echo ""
    echo "Commit blocked. Fix the errors above before committing."
    rm -f "$BUILD_LOG"
    exit 1
fi

# Step 2: Build-quality gates over that build log, plus link gates
echo ""
echo "[2/6] Running build-quality gates..."
if ! bash scripts/check-gates.sh "$BUILD_LOG"; then
    echo ""
    echo "Commit blocked. Fix the gate failures above before committing."
    rm -f "$BUILD_LOG"
    exit 1
fi
rm -f "$BUILD_LOG"

# Step 3: Lake build Morph.Tests
echo ""
echo "[3/6] Running lake build Morph.Tests..."
TESTS_LOG=$(mktemp /tmp/morph_precommit_tests_XXXXXX.log)

if lake build Morph.Tests 2>&1 | tee "$TESTS_LOG"; then
    echo ""
    echo "[3/6] Morph.Tests build PASSED"
else
    echo ""
    echo "[3/6] Morph.Tests build FAILED"
    echo ""
    echo "First 10 errors:"
    grep "^error:" "$TESTS_LOG" | head -10
    echo ""
    echo "Commit blocked. Fix the test compilation errors above."
    rm -f "$TESTS_LOG"
    exit 1
fi
rm -f "$TESTS_LOG"

# Step 4: Python spec-tools tests (if available)
echo ""
echo "[4/6] Running Python spec-tools tests..."

SPEC_TOOLS_PYTEST=""
if [ -f ".venv/bin/pytest" ] && [ -d ".venv/lib" ]; then
    SPEC_TOOLS_PYTEST=".venv/bin/pytest"
elif command -v pytest &>/dev/null && python3 -c "import spec_tools" 2>/dev/null; then
    SPEC_TOOLS_PYTEST="pytest"
fi

if [ -n "$SPEC_TOOLS_PYTEST" ]; then
    if $SPEC_TOOLS_PYTEST scripts/tests/ --tb=short -q 2>&1 | tee /tmp/morph_precommit_pytest.log; then
        echo ""
        echo "[4/6] Python spec-tools tests PASSED"
    else
        echo ""
        echo "[4/6] Python spec-tools tests FAILED"
        echo ""
        echo "Commit blocked. Fix the failing Python tests above."
        exit 1
    fi
else
    echo "[4/6] Python spec-tools not found (skipped)."
    echo "       To enable: pip install -e scripts/ in a virtual environment."
fi

# Step 5: Python linting and type-checking (if available)
echo ""
echo "[5/6] Running ruff lint and mypy type-check..."

LINT_PASS=true

# Prefer .venv/bin/ tools over system tools
RUFF_CMD=""
MYPY_CMD=""
if [ -f ".venv/bin/ruff" ]; then
    RUFF_CMD=".venv/bin/ruff"
elif command -v ruff &>/dev/null; then
    RUFF_CMD="ruff"
fi

if [ -f ".venv/bin/mypy" ]; then
    MYPY_CMD=".venv/bin/mypy"
elif command -v mypy &>/dev/null; then
    MYPY_CMD="mypy"
fi

if [ -n "$RUFF_CMD" ]; then
    if $RUFF_CMD check scripts/spec_tools/ 2>&1 | tee /tmp/morph_precommit_ruff.log; then
        echo "  ruff check PASSED"
    else
        echo "  ruff check FAILED"
        LINT_PASS=false
    fi

    if $RUFF_CMD format --check scripts/spec_tools/ 2>&1 | tee /tmp/morph_precommit_format.log; then
        echo "  ruff format PASSED"
    else
        echo "  ruff format FAILED -- run 'ruff format scripts/spec_tools/' to fix"
        LINT_PASS=false
    fi
else
    echo "  ruff not found (skipped)."
fi

if [ -n "$MYPY_CMD" ]; then
    if $MYPY_CMD scripts/spec_tools/ --ignore-missing-imports 2>&1 | tee /tmp/morph_precommit_mypy.log; then
        echo "  mypy PASSED"
    else
        echo "  mypy FAILED"
        LINT_PASS=false
    fi
else
    echo "  mypy not found (skipped)."
fi

if [ "$LINT_PASS" = false ]; then
    echo ""
    echo "[5/6] Lint/type-check FAILED. Commit blocked."
    exit 1
fi
echo "[5/6] All lint/type-check PASSED"

# Step 6: spec-tools lint on staged markdown files (if available)
echo ""
echo "[6/6] Running spec-tools lint on markdown files..."
SPEC_TOOLS_CMD=""
if [ -f ".venv/bin/spec-tools" ]; then
    SPEC_TOOLS_CMD=".venv/bin/spec-tools"
elif command -v spec-tools &>/dev/null; then
    SPEC_TOOLS_CMD="spec-tools"
fi

if [ -n "$SPEC_TOOLS_CMD" ]; then
    # Jurisdiction (loop 131): the specification convention governs spec/
    # only — this matches CI (spec-validation.yml runs `lint spec`). Linting
    # every staged *.md flagged non-spec documents (CHANGELOG, heartbeat
    # notes, impl/ strategy docs) for missing spec sections they must not
    # have; that advisory noise trains reviewers to ignore this step.
    MD_FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'spec/*.md' 'spec/**/*.md' 2>/dev/null || true)
    if [ -n "$MD_FILES" ]; then
        LINT_OK=true
        for md_file in $MD_FILES; do
            if [ -f "$md_file" ]; then
                if ! $SPEC_TOOLS_CMD lint "$md_file" 2>&1; then
                    LINT_OK=false
                fi
            fi
        done
        if [ "$LINT_OK" = true ]; then
            echo "[6/6] spec-tools lint PASSED"
        else
            echo "[6/6] spec-tools lint FAILED (warnings only, commit allowed)"
        fi
    else
        echo "[6/6] No markdown files staged, skipping spec-tools."
    fi
else
    echo "[6/6] spec-tools not found (skipped)."
fi

echo ""
echo "========================================="
echo " Pre-commit checks PASSED"
echo "========================================="
echo ""
exit 0
